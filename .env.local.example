# ------------------------------------------------------------------
# 이 파일을 복사해서 .env.local 로 이름을 바꾼 뒤 실제 값을 채워 넣으세요.
#   PowerShell:  Copy-Item .env.local.example .env.local
#
# 값은 Supabase 대시보드 → 프로젝트 선택 → Settings → API 에서 확인합니다.
# .env.local 은 .gitignore 에 등록되어 있어 GitHub 에 올라가지 않습니다.
# ------------------------------------------------------------------

# Project URL (예: https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Project API keys → anon / public
# 브라우저에 노출되어도 되는 공개 키입니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project API keys → service_role (secret)
# 절대 브라우저에 노출하면 안 되는 키입니다.
# 이 앱은 서버(Server Component / Server Action)에서만 이 키를 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# 재고 데이터 소스 스위치 (lib/dataSource.ts)
#
# sheets   → 데스크탑/노트북/모니터/빔프로젝트/기타주변기기 구글시트를 직접 읽고 씀 (지금 기본값)
# supabase → 예전처럼 Supabase it_assets 테이블 사용 (Supabase 셋업 끝나면 이걸로 전환)
# ------------------------------------------------------------------
INVENTORY_DATA_SOURCE=sheets

# ------------------------------------------------------------------
# 구글시트 연동 공통 — 서비스 계정 (임대리스트 조회 + 재고 시트 읽기/쓰기 공용)
#
# 값이 비어 있으면 구글시트 관련 기능만 조용히 꺼집니다 (재고 목록은 SetupGuide 안내 화면으로).
#
# 준비 방법:
#   1. https://console.cloud.google.com → 프로젝트 선택 → IAM 및 관리자 → 서비스 계정
#      → 새 서비스 계정 생성 → 키 → JSON 키 생성/다운로드
#   2. 대상 구글시트를 열어 "공유" → 위에서 만든 서비스 계정 이메일을 추가
#      - 임대리스트: "뷰어" 권한이면 충분 (읽기 전용 조회)
#      - 재고 시트(데스크탑/노트북/모니터/빔프로젝트/기타주변기기): 앱이 행을 직접 쓰기 때문에
#        반드시 "편집자" 권한으로 추가
#   3. 아래 값을 다운받은 JSON 키 파일(client_email / private_key)에서 채우기
# ------------------------------------------------------------------

# JSON 키 파일의 client_email 값
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# JSON 키 파일의 private_key 값을 그대로 붙여넣으세요 (줄바꿈은 \n 그대로 둬도 됩니다).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ------------------------------------------------------------------
# 임대리스트 조회 (자산 등록 폼 자동완성용, 읽기 전용)
# ------------------------------------------------------------------

# 임대리스트 구글시트의 스프레드시트 ID (URL의 .../spreadsheets/d/<이 부분>/edit)
GOOGLE_RENTAL_SHEET_ID=

# 조회할 탭(시트) 이름 — 비워두면 "임대리스트"를 씁니다.
GOOGLE_RENTAL_SHEET_TAB=임대리스트

# ------------------------------------------------------------------
# 재고 목록 읽기/쓰기 (메인 화면이 여기서 데이터를 가져옵니다)
# ------------------------------------------------------------------

# 재고 시트의 스프레드시트 ID — 비워두면 GOOGLE_RENTAL_SHEET_ID 값을 그대로 씁니다
# (임대리스트와 같은 워크북에 탭만 나뉘어 있는 경우가 많아서).
GOOGLE_INVENTORY_SHEET_ID=

# 탭(시트) 이름이 아래 기본값과 다르면 개별로 바꿔주세요.
GOOGLE_INVENTORY_SHEET_TAB_DESKTOP=데스크탑
GOOGLE_INVENTORY_SHEET_TAB_NOTEBOOK=노트북
GOOGLE_INVENTORY_SHEET_TAB_MONITOR=모니터
GOOGLE_INVENTORY_SHEET_TAB_BEAM=빔프로젝트
GOOGLE_INVENTORY_SHEET_TAB_PERIPHERAL=기타주변기기

# 화면 상단 "스프레드시트 열기" 버튼이 열 주소 — 비워두면 GOOGLE_INVENTORY_SHEET_ID(없으면
# GOOGLE_RENTAL_SHEET_ID)로부터 자동으로 만듭니다. 다른 시트를 열고 싶을 때만 채우세요.
# https://docs.google.com/spreadsheets/... 형태만 허용됩니다.
INVENTORY_SPREADSHEET_URL=
