# ------------------------------------------------------------------
# 이 파일을 복사해서 .env.local 로 이름을 바꾼 뒤 실제 값을 채워 넣으세요.
#   PowerShell:  Copy-Item .env.local.example .env.local
#
# 값은 Supabase 대시보드 → 프로젝트 선택 → Settings → API 에서 확인합니다.
# .env.local 은 .gitignore 에 등록되어 있어 GitHub 에 올라가지 않습니다.
# ------------------------------------------------------------------

# Project URL (예: https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Project API keys → anon / public
# 브라우저에 노출되어도 되는 공개 키입니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project API keys → service_role (secret)
# 절대 브라우저에 노출하면 안 되는 키입니다.
# 이 앱은 서버(Server Component / Server Action)에서만 이 키를 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=
